      "shortLabel": "זוגיות",
      "protocol": {
        "practices": [
          { "id": "couple.p01", "text": "כלל שלוש הנשימות, לפני כל תגובה." },
          { "id": "couple.p02", "text": "“מה אתה צריך ממני עכשיו — פתרון או הקשבה?”" },
          { "id": "couple.p03", "text": "להחליף “אתה תמיד” ב“כשזה קרה, הרגשתי”." },
          { "id": "couple.p04", "text": "עשר דקות ביום של נוכחות מלאה, בלי מסך." },
          { "id": "couple.p05", "text": "לזכור: בן או בת הזוג הם המורה הכי מדויק שיש לך, לא המכשול." }
        ],
        "relatedToolIds": ["double-exhale", "last-day"]
      }
    },
