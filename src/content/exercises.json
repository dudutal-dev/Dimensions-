        { "id": "t1.s05", "type": "breath", "text": "שאיפה חמש · נשיפה שש", "durationSec": 264, "breathPattern": { "inhaleSec": 5, "holdInSec": 0, "exhaleSec": 6, "holdOutSec": 0 } },
        { "id": "t1.s06", "type": "instruction", "text": "אם הקשב נדד, זה טבעי. חזור בעדינות אל הנשימה.", "durationSec": 8 },
        { "id": "t1.s07", "type": "breath", "text": "שאיפה חמש · נשיפה שש", "durationSec": 264, "breathPattern": { "inhaleSec": 5, "holdInSec": 0, "exhaleSec": 6, "holdOutSec": 0 } },
