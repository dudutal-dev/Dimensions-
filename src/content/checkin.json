    { "id": "before-first-meeting", "label": "לפני ישיבה ראשונה", "defaultTime": "09:00" },
    { "id": "after-lunch", "label": "אחרי ארוחת צהריים", "defaultTime": "13:30" },
    { "id": "home", "label": "כניסה הביתה", "defaultTime": "18:30" },
    { "id": "before-sleep", "label": "לפני שינה", "defaultTime": "22:30" }
  ],
  "results": {
    "d3": {
      "title": "3D עכשיו",
      "text": "הגוף דרוך והמחשבה מרגישה כמו עובדה. עצם זה שתפסת את זה — זה כבר צעד אל המתבונן.",
      "shiftGroup": "from-3d"
    },
    "d3-d4": {
      "title": "בין 3D ל-4D",
      "text": "יש כיווץ, ויש גם מי שרואה אותו. הרווח כבר התחיל להיפתח.",
      "shiftGroup": "from-3d"
    },
    "d4": {
      "title": "4D עכשיו",
      "text": "אתה מתבונן במה שקורה בך. מכאן הדרך אינה עוד הבנה, אלא ירידה אל הלב.",
      "shiftGroup": "from-4d"
    },
    "d4-d5": {
      "title": "בין 4D ל-5D",
      "text": "המתבונן ער, והלב מתחיל להיפתח. אפשר להפסיק לעבוד על עצמך ולנוח במה שכבר כאן.",
      "shiftGroup": "from-4d"
    },
    "d5": {
      "title": "5D עכשיו",
      "text": "נשימה רכה, קשב רחב, הווה. אין מה לעשות עם זה — רק לרשום, ולהמשיך מכאן."
    }
  },
  "explain": {
    "channelLabels": { "body": "הגוף", "thought": "המחשבה", "emotion": "הרגש", "time": "הזמן" },
    "template": "{channel} הצביע על {dim}",
    "mixedNote": "הערוצים לא הסכימו ביניהם. ערוץ אחד יכול לשקר — בעיקר המחשבה; הגוף הוא הערוץ הישר ביותר."
  },
  "quickMode": {
    "title": "רישום מהיר",
    "hint": "לחיצה ארוכה על “בדיקה” — מצב ותחום, בהקשה אחת."
