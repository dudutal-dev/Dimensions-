            { "id": "past", "label": "בעבר", "weights": { "d3": 0.55, "d4": 0.35, "d5": 0.1 } },
            { "id": "future", "label": "בעתיד", "weights": { "d3": 0.6, "d4": 0.3, "d5": 0.1 } },
