            { "id": "belly", "label": "בבטן", "weights": { "d3": 0.1, "d4": 0.3, "d5": 0.6 } }
          ]
        },
        {
          "id": "breath-flow",
          "kind": "choice",
          "prompt": "ואיך היא נעה?",
