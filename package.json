{
  "name": "dimension-compass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "מצפן המימדים — PWA לאימון תודעת 3D/4D/5D",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "content:check": "tsx tools/build-content.mjs",
    "content:review": "tsx tools/content-review.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
