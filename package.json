{
  "name": "dimension-compass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "מצפן המימדים — PWA לאימון תודעת 3D/4D/5D",
  "scripts": {
    "dev": "vite",
    "dev:phone": "cross-env DC_PHONE=1 vite",
    "build": "npm run content:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "content:check": "tsx tools/build-content.mjs",
    "content:review": "tsx tools/content-review.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:qa": "cross-env DC_E2E=sweep playwright test && cross-env DC_E2E=perf playwright test",
    "dist:check": "node tools/check-dist.mjs",
    "icons": "node tools/make-icons.mjs",
    "voice:voices": "node tools/voice/voices.mjs",
    "voice:estimate": "node tools/voice/estimate.mjs",
    "voice:audition": "node tools/voice/audition.mjs"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
